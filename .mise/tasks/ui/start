#!/usr/bin/env bash
#MISE description="Start the inspector dev server on http://localhost:5173 (proxies /api to port 8080)"

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091
source "${MISE_PROJECT_ROOT:?}/.mise/lib/terminal.sh"
set_terminal_title "ui"

readonly inspector_root="${MISE_PROJECT_ROOT}/scaffold/inspector"

# Install on a fresh checkout, or reinstall when package-lock.json is newer than the last
# install (e.g. after a git pull). npm records each install in node_modules/.package-lock.json.
readonly installed_marker="${inspector_root}/node_modules/.package-lock.json"
if [[ ! -f "${installed_marker}" || "${inspector_root}/package-lock.json" -nt "${installed_marker}" ]]; then
    npm --prefix "${inspector_root}" ci
fi

exec npm --prefix "${inspector_root}" run dev -- "$@"
